# Kayra Perfumes — environment template.
# Copy to `.env` and fill in real values. Never commit `.env`.
# Anything prefixed with VITE_ is exposed to the browser — never put a secret there.

# ---------------------------------------------------------------- public site
# Canonical origin used for canonical tags, OG/Twitter images and sitemap URLs.
VITE_SITE_URL=https://kayraperfumes.in

# ------------------------------------------------------------------- database
# Backend (Supabase-compatible). Server-side:
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
SUPABASE_SERVICE_ROLE_KEY=
# Browser-side (publishable values only):
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# ------------------------------------------------------------------- payments
# Provider is swappable in src/lib/payments/provider.server.ts ("razorpay" | "manual").
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --------------------------------------------------------------- email (Resend)
# Nothing is sent until this is set, and only to customers who opted in.
EMAIL_API_KEY=
EMAIL_FROM=orders@kayraperfumes.in

# ------------------------------------------- WhatsApp Business (Meta Cloud API)
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=

# ------------------------------------------------------------- admin / ops API
# Bearer token for POST /api/public/hooks/shipment
ADMIN_SECRET=

# ------------------------------------------------------------------- analytics
ANALYTICS_ID=
